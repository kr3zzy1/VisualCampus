# Search provider: wikimedia works without a key; serpapi expands web image search.
SEARCH_PROVIDER=wikimedia
SERPAPI_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CACHE_TTL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=12
MAX_CANDIDATES_PER_CATEGORY=8
ALLOWED_ORIGINS=http://localhost:5173
